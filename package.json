{
  "name": "crossmark",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "convex dev",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write apps packages convex scripts tests docs README.md package.json tsconfig.json vite.config.ts",
    "test:browser": "node scripts/smoke.mjs",
    "test:firefox": "node scripts/firefox-smoke.mjs",
    "package:firefox": "npm run build && node scripts/package-firefox.mjs",
    "lint:firefox": "npm run build && web-ext lint --source-dir dist/firefox",
    "sign:firefox": "npm run build && node scripts/sign-firefox.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "1.6.33",
    "convex": "^1.31.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@vitejs/plugin-react": "^5.0.0",
    "convex-test": "^0.0.41",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.8",
    "selenium-webdriver": "^4.49.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  }
}

# Public extension configuration; rebuild after changing either origin.
# `npm run backend` creates .env.local for a local Convex deployment.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
# Configure GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET and
# AUTH_TRUSTED_ORIGINS on Convex, NOT as VITE_ variables. See docs/google-oauth-setup.md.
